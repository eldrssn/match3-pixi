# Frontend deployment environment example.
# Copy to .env or configure the same keys in CI/CD variables.
# Do not store real secrets in this file.

# Compose / CI deployment variables.
# Used by docker-compose.yaml for service name, image and reverse proxy labels.
PROJECT=
APP=frontend
STAGE=tst
CI_COMMIT_REF_SLUG=main
IMAGE_FULL=registry.example.com//frontend:latest
DOMAIN=
APP_PATH=/
APP_PORT=8080

# Vite build-time variables.
# These values are embedded into the static bundle during image build.

# Application environment: dev | test | production.
VITE_APP_ENV=production

# Optional Vite public base path for CDN/static hosting, for example /match3/.
VITE_CDN_BASE_URL=/

# Level editor (/editor) and the «Редактор» button on the main page: true | false.
# On by default in the dev server, off by default in `vite build`. Turn it on for
# the staging build the game designer works with; leave it off in production -
# without it the editor chunk is not in the bundle at all.
VITE_ENABLE_EDITOR=false
